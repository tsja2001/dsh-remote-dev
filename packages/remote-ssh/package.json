{
  "name": "@tsja/dsh-remote-ssh",
  "version": "0.3.0",
  "description": "DeepSeek Harness SSH plugin for AI remote development: run commands and read, write, or browse files on Linux and Windows servers.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./transport": "./transport.js",
    "./profiles": "./profiles.js",
    "./tools": "./tools.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "transport.js",
    "profiles.js",
    "tools.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check transport.js && node --check profiles.js && node --check tools.js && node --check client.js",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run check"
  },
  "license": "MIT",
  "author": "tsja",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "deepseek",
    "deepseek-ai",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ai-agent",
    "ai-coding-agent",
    "ssh",
    "sftp",
    "remote-development",
    "remote-execution",
    "remote-server",
    "devops",
    "linux",
    "windows"
  ],
  "homepage": "https://github.com/tsja2001/dsh-remote-ssh#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsja2001/dsh-remote-ssh.git",
    "directory": "packages/remote-ssh"
  },
  "bugs": {
    "url": "https://github.com/tsja2001/dsh-remote-ssh/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1",
    "ssh2": "^1.17.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web",
      "immediately": false
    }
  }
}
